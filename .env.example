# Copy this file to .env and fill in real values.
# Do NOT commit .env to version control.

# Database
DATABASE_URL=postgresql://pandacrm:p4nd1crm_s3cure_2026@db:5432/pandacrm?schema=public

# Authentication
AUTH_SECRET=change_me_to_a_strong_random_secret
AUTH_URL=https://pandacrm.com.ng

# Redis (for rate limiting & caching)
REDIS_URL=redis://redis:6379

# App Configuration
NEXT_PUBLIC_APP_URL=https://pandacrm.com.ng

# Email (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_user
BREVO_SMTP_PASS=your_brevo_pass

# Optional platform-wide default sender.
# When set, this sender is used for any workspace that does not have its own
# verified sender identity. The email domain must be verified in your Brevo
# account (Settings → Senders & Domains) before campaigns can send.
DEFAULT_SENDER_DOMAIN=mail.kreatixtech.com
DEFAULT_SENDER_EMAIL=noreply@mail.kreatixtech.com
DEFAULT_SENDER_NAME="Kreatix Tech"
DEFAULT_SENDER_REPLYTO=
